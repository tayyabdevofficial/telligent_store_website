# --- Environments & Secrets ---
.env
.env.*
!.env.example
/auth.json

# --- Server Deployment & Webhook Scripts ---
/deploy.sh
/deploy.log
/public/deploy-webhook.php

# --- Storage & Uploaded Media (Preserve Server Files & Thumbnails) ---
/storage/*.key
/storage/pail
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/public/storage
/public/uploads

# --- Dependencies & Build Artifacts ---
/vendor
/node_modules
/public/build
/public/hot
/public/fonts-manifest.dev.json
/bootstrap/ssr

# --- Wayfinder Auto-Generated Files ---
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder

# --- Logs & Temporary Files ---
*.log
*.zip
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Databases & Testing Cache ---
*.sqlite
*.sqlite-journal
/.phpunit.cache
.phpunit.result.cache

# --- OS & Editor Configurations ---
.DS_Store
Thumbs.db
Homestead.json
Homestead.yaml
.phpactor.json
/.fleet
/.idea
/.nova
/.vscode
/.zed